# Copied to ~/.config/local-agent/local-agent.env by scripts/40-claude-code.sh
# Real environment variables override these.

# --- Local LLM server (OpenAI-compatible) ---
# LM Studio (default):   http://127.0.0.1:1234/v1
# mlx_lm.server:         http://127.0.0.1:8080/v1
# Ollama:                http://127.0.0.1:11434/v1
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_API_KEY=local

# Model ids exactly as `lms ls` / GET /v1/models reports them. Verify after downloading.
LOCAL_MODEL_GENERAL=openai/gpt-oss-120b
LOCAL_MODEL_CODER=ornith-1.5-35b-a3b-mlx
LOCAL_MODEL_FAST=ornith-1.5-35b-a3b-mlx
# Where 10-models.sh downloads a model whose id `lms get` cannot resolve (not in LM Studio's
# catalog): a Hugging Face URL. Empty = `lms get <id>`.
LOCAL_MODEL_GENERAL_SOURCE=
LOCAL_MODEL_CODER_SOURCE=https://huggingface.co/ornith-ai/Ornith-1.5-35B-A3B-MLX-4bit
# Context length (tokens) that scripts/10-models.sh loads models with and sets as LM Studio's
# default for JIT loads. Not read by the MCP server.
LOCAL_MODEL_CTX=65536
# Which models 10-models.sh loads up front: both | general | none (the rest load JIT).
LOCAL_MODEL_PRELOAD=both

# Input budget per call in characters (~4 chars/token). Keep below the loaded context length.
LOCAL_CTX_CHARS=120000
LOCAL_CHUNK_CHARS=40000
LOCAL_CONCURRENCY=2
LOCAL_REQUEST_TIMEOUT=900
LOCAL_MAX_OUTPUT_TOKENS=4096
# Reasoning effort sent to the server (low | medium | high; empty = model default).
LOCAL_REASONING_EFFORT=
# Coder-model override (e.g. none to turn off thinking on a thinking coder). Empty = same as above.
LOCAL_REASONING_EFFORT_CODER=
# Tokens added to max_tokens on coder/fast calls, for a coder that always thinks (Ornith-1.5
# ignores reasoning_effort=none). Without it, internal calls with small budgets (150-token
# research queries) come back empty. 0 for non-thinking coders.
LOCAL_REASONING_RESERVE_CODER=2048

# --- Web search ---
SEARXNG_URL=http://127.0.0.1:8888

# --- Safety ---
# Colon-separated roots the tools may read (and local_agent_task may modify via worktrees).
LOCAL_AGENT_ALLOWED_ROOTS=~/src:~/data:~/Documents
LOCAL_AGENT_MAX_FILE_BYTES=20971520
LOCAL_AGENT_MAX_FILES=500
# 1 = let the local model evaluate pandas expressions in local_analyze_data (see README: Security)
LOCAL_AGENT_ALLOW_PANDAS_EVAL=0

# --- Local coding agent ---
OPENCODE_BIN=opencode
OPENCODE_MODEL=lmstudio/ornith-1.5-35b-a3b-mlx
# Extra `opencode run` flags. --standalone (OpenCode v2) gives each task a private server that dies
# with it instead of using the shared background service. Set it empty for OpenCode 1.x, which
# rejects the flag (its `run` already starts a private server).
OPENCODE_RUN_ARGS=--standalone

LOCAL_AGENT_LEDGER=~/Library/Logs/local-agent-mcp/usage.jsonl
