{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (Mac Studio)",
      "options": { "baseURL": "http://127.0.0.1:1234/v1" },
      "models": {
        "qwen/qwen3-coder-30b": { "name": "Qwen3 Coder 30B (local)" },
        "openai/gpt-oss-120b": { "name": "gpt-oss 120B (local)" }
      }
    }
  },
  "model": "lmstudio/qwen/qwen3-coder-30b",
  "small_model": "lmstudio/qwen/qwen3-coder-30b",
  "share": "disabled",
  "autoupdate": false,
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
    "bash": {
      "git push*": "deny",
      "git remote*": "deny",
      "git reset --hard*": "deny",
      "rm -rf /*": "deny",
      "sudo *": "deny",
      "curl *| *sh*": "deny",
      "*": "allow"
    }
  }
}
