# SearXNG settings for local-agent. scripts/20-searxng.sh fills in the secret.
use_default_settings: true

general:
  instance_name: "studio-searxng"

server:
  secret_key: "__SECRET__"
  limiter: false          # local-only; no bot protection needed
  image_proxy: false
  bind_address: "0.0.0.0" # inside the container; host port is bound to 127.0.0.1 only

search:
  safe_search: 0
  autocomplete: ""
  formats:
    - html
    - json                # REQUIRED for the MCP server

outgoing:
  request_timeout: 6.0
  max_request_timeout: 15.0
