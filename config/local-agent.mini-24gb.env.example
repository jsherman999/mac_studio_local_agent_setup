# POC profile for a 24 GB Apple-silicon Mac (e.g. Mac mini M4 Pro) while waiting for the Studio.
# Used by `make poc` (ENV_TEMPLATE=this file) and copied to ~/.config/local-agent/local-agent.env.
# Same keys as local-agent.env.example; only sizes, model ids, and roots differ.
#
# Memory: ~24 GB total, ~16 GB usable by the GPU by default. Only one model is resident at a
# time; LM Studio JIT-loads the other on demand (unloadPreviousJITModelOnLoad).
#   general  openai/gpt-oss-20b   GGUF MXFP4, ~12 GB, MoE 3.6B active (small sibling of gpt-oss-120b)
#   coder    qwen/qwen3.5-9b      MLX 4-bit, ~6 GB, dense, tool calling

# --- Local LLM server (OpenAI-compatible) ---
LOCAL_LLM_BASE_URL=http://127.0.0.1:1234/v1
LOCAL_LLM_API_KEY=local

LOCAL_MODEL_GENERAL=openai/gpt-oss-20b
LOCAL_MODEL_CODER=qwen/qwen3.5-9b
LOCAL_MODEL_FAST=openai/gpt-oss-20b
# Context length (tokens) that scripts/10-models.sh loads models with and sets as LM Studio's
# default for JIT loads. Not read by the MCP server.
LOCAL_MODEL_CTX=32768
# Models 10-models.sh pins with `lms load`: both | general | none. Pinned models are never
# JIT-unloaded, so on 24 GB use none and let LM Studio swap roles on demand.
LOCAL_MODEL_PRELOAD=none

# Input budget per call in characters (~4 chars/token). 32k ctx ~= 128k chars; leave room for
# the system prompt, line numbers, reasoning, and the answer.
LOCAL_CTX_CHARS=60000
LOCAL_CHUNK_CHARS=24000
LOCAL_CONCURRENCY=2
LOCAL_REQUEST_TIMEOUT=900
LOCAL_MAX_OUTPUT_TOKENS=4096
# Reasoning effort sent to the server (low | medium | high; empty = model default). Low keeps
# gpt-oss from spending the output budget on hidden reasoning.
LOCAL_REASONING_EFFORT=low
# Coder override. "none" turns Qwen3.5 thinking off: at low temperature it can loop until
# max_tokens. (OpenCode sends its own requests and is not affected.)
LOCAL_REASONING_EFFORT_CODER=none

# --- Web search ---
SEARXNG_URL=http://127.0.0.1:8888

# --- Safety ---
LOCAL_AGENT_ALLOWED_ROOTS=~/cc_projects:~/src:~/data:~/Documents
LOCAL_AGENT_MAX_FILE_BYTES=20971520
LOCAL_AGENT_MAX_FILES=500
LOCAL_AGENT_ALLOW_PANDAS_EVAL=0

# --- Local coding agent ---
OPENCODE_BIN=opencode
OPENCODE_MODEL=lmstudio/qwen/qwen3.5-9b
# Extra `opencode run` flags. OpenCode 1.x (current release, 1.19.x) rejects --standalone; its `run`
# already starts a private server, and timeouts kill the whole process group. On OpenCode v2, set
# --standalone so each task gets a private server that dies with it.
OPENCODE_RUN_ARGS=

LOCAL_AGENT_LEDGER=~/Library/Logs/local-agent-mcp/usage.jsonl
