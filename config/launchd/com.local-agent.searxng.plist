<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchAgent (user): bring up the Podman VM and the SearXNG container at login. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.local-agent.searxng</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string><string>-lc</string>
    <string>podman machine start 2>/dev/null; sleep 5; podman start searxng</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/tmp/searxng-agent.log</string>
  <key>StandardErrorPath</key><string>/tmp/searxng-agent.log</string>
</dict>
</plist>
